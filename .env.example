# Copy to .env and fill in. Only `pnpm triage` and `pnpm eval` need the key;
# the server and `pnpm test` run without it.
ANTHROPIC_API_KEY=

# Active fixture scenario for the stdio server
SCENARIO=checkout-latency

# HTTP transport (Vercel / local http)
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60

# Eval spend guard (USD); the eval run aborts above this
EVAL_MAX_COST_USD=5
